# Automatically set by Vercel once you connect a Postgres database
# (Storage tab -> Connect Database -> Neon). You don't need to set this
# yourself in production. For local dev, paste the connection string
# Neon/Vercel gives you.
DATABASE_URL=

# The passcode facilitators enter to view the cohort dashboard at /facilitator.
# Set this in Vercel: Project -> Settings -> Environment Variables.
# If not set, it defaults to "readiness2026" (see lib/db.ts).
FACILITATOR_PASSWORD=readiness2026
